    {
      "id": "Scene-29",
      "name": "29-总结选择工具",
      "paragraphs": [
        116
      ],
      "segments": [
        "工具不用记全，按需要挑一个顺手的：学生选资料整理强的，",
        "上班族选文件处理强的，创作者选批量处理强的，",
        "程序员直接用编程 Agent。",
        "费用别只看单价，真实任务试过，好用再付费。"
      ],
