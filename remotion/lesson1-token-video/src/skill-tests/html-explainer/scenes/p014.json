  "blocks": [
    {
      "text": "后来",
      "spoken": "后来，",
      "from": 1,
      "to": 25,
      "local_start_sec": 0.0,
      "global_start_sec": 113.24,
      "global_end_sec": 114.088,
      "size": 44
    },
    {
      "text": "事情变了",
      "spoken": "事情变了。",
      "from": 26,
      "to": 64,
      "local_start_sec": 0.848,
      "global_start_sec": 114.088,
      "global_end_sec": 115.388,
      "size": 44
    },
    {
      "text": "产品把这一套能力",
      "spoken": "产品把这一套能力",
      "from": 65,
      "to": 101,
      "local_start_sec": 2.148,
      "global_start_sec": 115.388,
      "global_end_sec": 116.6,
      "size": 44
    },
    {
      "text": "套上了一个\"桌面壳\"",
      "spoken": "套上了一个 \"桌面壳\"，",
      "from": 102,
      "to": 157,
      "local_start_sec": 3.361,
      "global_start_sec": 116.6,
      "global_end_sec": 118.475,
      "size": 44
    },
    {
      "text": "像Codex、豆包工作、",
      "spoken": "像 Codex、豆包工作、",
      "from": 158,
      "to": 223,
      "local_start_sec": 5.236,
      "global_start_sec": 118.475,
      "global_end_sec": 120.663,
      "size": 44
    },
    {
      "text": "千问办公、workbuddy这些",
      "spoken": "千问 办公 、workbuddy 这些，",
      "from": 224,
      "to": 309,
      "local_start_sec": 7.423,
      "global_start_sec": 120.663,
      "global_end_sec": 123.538,
      "size": 44
    },
    {
      "text": "你不用敲命令了",
      "spoken": "你不用敲命令了，",
      "from": 310,
      "to": 345,
      "local_start_sec": 10.298,
      "global_start_sec": 123.538,
      "global_end_sec": 124.75,
      "size": 44
    },
    {
      "text": "用大白话聊天就能指挥它",
      "spoken": "用大白话聊天就能指挥它。",
      "from": 346,
      "to": 423,
      "local_start_sec": 11.511,
      "global_start_sec": 124.75,
      "global_end_sec": 127.325,
      "size": 44
    },
    {
      "text": "但核心没变",
      "spoken": "但核心没变，",
      "from": 424,
      "to": 463,
      "local_start_sec": 14.085,
      "global_start_sec": 127.325,
      "global_end_sec": 128.688,
      "size": 44
    },
    {
      "text": "听懂需求、调用工具、交付结果",
      "spoken": "听懂需求、调用工具、交付结果。",
      "from": 464,
      "to": 573,
      "local_start_sec": 15.448,
      "global_start_sec": 128.688,
      "global_end_sec": 132.338,
      "size": 44
    },
    {
      "text": "变的只是外壳",
      "spoken": "变的只是外壳，",
      "from": 574,
      "to": 615,
      "local_start_sec": 19.098,
      "global_start_sec": 132.338,
      "global_end_sec": 133.738,
      "size": 44
    },
    {
      "text": "普通人终于用得上了",
      "spoken": "普通人终于用得上了。",
      "from": 616,
      "to": 673,
      "local_start_sec": 20.498,
      "global_start_sec": 133.738,
      "global_end_sec": 135.688,
      "size": 44
    },
    {
      "text": "所以",
      "spoken": "所以，",
      "from": 674,
      "to": 703,
      "local_start_sec": 22.448,
      "global_start_sec": 135.688,
      "global_end_sec": 136.663,
      "size": 44
    },
    {
      "text": "别再说\"我不会编程\"了",
      "spoken": "别再说 \"我不会编程\" 了。",
      "from": 704,
      "to": 759,
      "local_start_sec": 23.423,
      "global_start_sec": 136.663,
      "global_end_sec": 138.538,
      "size": 44
    },
    {
      "text": "会编程的人只是早用上而已",
      "spoken": "会编程的人只是早用上而已。",
      "from": 760,
      "to": 844,
      "local_start_sec": 25.298,
      "global_start_sec": 138.538,
      "global_end_sec": 141.363,
      "size": 44
    },
    {
      "text": "现在",
      "spoken": "现在，",
      "from": 845,
      "to": 877,
      "local_start_sec": 28.123,
      "global_start_sec": 141.363,
      "global_end_sec": 142.463,
      "size": 44
    },
    {
      "text": "人人都能用了",
      "spoken": "人人都能用了。",
      "from": 878,
      "to": 906,
      "local_start_sec": 29.223,
      "global_start_sec": 142.463,
      "global_end_sec": 143.431,
      "size": 44
    }
  ]
