      "size": 44
    },
    {
      "text": "都是自己打开日历",
      "spoken": "都是自己打开日历，",
      "from": 41,
      "to": 86,
      "local_start_sec": 1.35,
      "global_start_sec": 165.1,
      "global_end_sec": 166.625,
      "size": 44
    },
    {
      "text": "一条一条地加",
      "spoken": "一条一条地加，",
      "from": 87,
      "to": 122,
      "local_start_sec": 2.875,
      "global_start_sec": 166.625,
      "global_end_sec": 167.8,
      "size": 44
    },
    {
      "text": "加完还要设提醒、写备注",
      "spoken": "加完还要设提醒、写备注，",
      "from": 123,
