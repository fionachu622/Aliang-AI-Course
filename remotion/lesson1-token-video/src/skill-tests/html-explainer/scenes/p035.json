scene .focus{border:2px solid var(--accent-border);background:var(--accent-soft);box-shadow:0 10px 60px var(--accent-glow)}.agent-html-scene .panel{background:var(--card-bg);border:1px solid var(--line);border-radius:20px;padding:38px}.agent-html-scene .label{font-size:26px;color:var(--text-dim);line-height:1.5}.agent-html-scene .large{font-size:96px;font-weight:650;line-height:1.2}.agent-html-scene .body{font-size:36px;line-height:1.6}.agent-html-scene .pill{padding:10px 22px;border:1px solid var(--line);border-radius:40px;font-size:24px;color:var(--text-dim)}.agent-html-scene{width:1920px;height:1080px;font-family:'PingFang SC','Microsoft YaHei',sans-serif}.agent-html-scene .heading{position:relative}.agent-html-scene .heading h1{color:var(--accent);text-shadow:0 8px 45px var(--accent-glow)}.agent-html-scene .heading h1{margin-top:18px}.agent-html-scene .diagram{width:1696px;height:470px;margin-top:30px;overflow:visible}.agent-html-scene svg rect{fill:var(--card-bg);stroke:var(--line);stroke-width:2}.agent-html-scene svg text{fill:var(--text);font-family:'PingFang SC','Microsoft YaHei',sans-serif}.agent-html-scene .nt{font-size:42px;font-weight:600}.agent-html-scene .ns{font-size:26px;fill:var(--text-dim)}.agent-html-scene .conn{fill:none;stroke:var(--accent);stroke-width:3}.agent-html-scene .big{font-size:120px;font-weight:650;fill:var(--accent)}.agent-html-scene .key rect{fill:var(--accent-soft);stroke:var(--accent-border)}.agent-html-scene .hero{font-size:100px;font-weight:650;fill:var(--accent)}.agent-html-scene .tiny{font-size:24px;fill:var(--text-dim)} ",
