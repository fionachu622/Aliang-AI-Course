  "blocks": [
    {
      "text": "其实这样的Agent",
      "spoken": "其实这样的 Agent，",
      "from": 1,
      "to": 53,
      "local_start_sec": 0.0,
      "global_start_sec": 93.44,
      "global_end_sec": 95.194,
      "size": 44
    },
    {
      "text": "不是一开始就人人都能用的",
      "spoken": "不是一开始就人人都能用的。",
      "from": 54,
      "to": 129,
      "local_start_sec": 1.754,
      "global_start_sec": 95.194,
      "global_end_sec": 97.731,
      "size": 44
    },
    {
      "text": "最早",
      "spoken": "最早，",
      "from": 130,
      "to": 158,
      "local_start_sec": 4.291,
      "global_start_sec": 97.731,
      "global_end_sec": 98.694,
      "size": 44
    },
    {
      "text": "只有程序员能用它",
      "spoken": "只有程序员能用它，",
      "from": 159,
      "to": 207,
      "local_start_sec": 5.253,
      "global_start_sec": 98.694,
      "global_end_sec": 100.356,
      "size": 44
    },
    {
      "text": "在一个黑屏的终端里敲命令",
      "spoken": "在一个黑屏的终端里敲命令，",
      "from": 208,
      "to": 268,
      "local_start_sec": 6.916,
      "global_start_sec": 100.356,
      "global_end_sec": 102.381,
      "size": 44
    },
    {
      "text": "让它写代码、跑程序",
      "spoken": "让它写代码、跑程序。",
      "from": 269,
      "to": 338,
      "local_start_sec": 8.941,
      "global_start_sec": 102.381,
      "global_end_sec": 104.694,
      "size": 44
    },
    {
      "text": "这类工具统称",
      "spoken": "这类工具统称",
      "from": 339,
      "to": 374,
      "local_start_sec": 11.253,
      "global_start_sec": 104.694,
      "global_end_sec": 105.894,
      "size": 44
    },
    {
      "text": "Coding Agent",
      "spoken": "Coding Agent，",
      "from": 375,
      "to": 411,
      "local_start_sec": 12.454,
      "global_start_sec": 105.894,
      "global_end_sec": 107.144,
      "size": 44
    },
    {
      "text": "代表就是ClaudeCode",
      "spoken": "代表就是 Claude Code。",
      "from": 412,
      "to": 477,
      "local_start_sec": 13.704,
      "global_start_sec": 107.144,
      "global_end_sec": 109.331,
      "size": 44
    },
    {
      "text": "那时候",
      "spoken": "那时候，",
      "from": 478,
      "to": 504,
      "local_start_sec": 15.891,
      "global_start_sec": 109.331,
      "global_end_sec": 110.243,
      "size": 44
    },
    {
      "text": "普通人根本用不了",
      "spoken": "普通人根本用不了，",
      "from": 505,
      "to": 549,
      "local_start_sec": 16.803,
      "global_start_sec": 110.243,
      "global_end_sec": 111.743,
      "size": 44
    },
